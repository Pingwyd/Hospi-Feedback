# Copy to .env for local work. Never commit real values.

# local | development | test | staging | production
# Seed script allowlist is local, development, dev, test only.
ENVIRONMENT=local

# Supabase (local `supabase start` values go here, not in git)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy JWT_SECRET from `supabase status -o env` (local Supabase default shown in docs).
SUPABASE_JWT_SECRET=

# Admin login MFA. Off by default in local/dev/test; on in staging/production.
# Set true locally if you want to exercise the TOTP flow.
# ADMIN_2FA_REQUIRED=true

# AES-256-GCM key for admins.telegram_chat_id_encrypted (32 bytes, base64).
# Generate with: python -c "from app.core.crypto import generate_aes256_key_b64; print(generate_aes256_key_b64())"
TELEGRAM_CHAT_ID_ENCRYPTION_KEY=

# Access-code session JWT (Phase 2)
ACCESS_CODE_JWT_SECRET=
SHARED_ACCESS_CODE=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_IDENTIFIER_PEPPER=
BOT_SERVICE_SECRET=
API_BASE_URL=http://127.0.0.1:8000

# Rate limiting (API-side counters for web fingerprints and Telegram hashes)
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=20
TELEGRAM_LINK_CODE_TTL_SECONDS=600

# Internal job routes (purge, duplicate-scan, escalation-export purge)
X_INTERNAL_JOB_SECRET=
REPORT_RETENTION_DAYS=30
DUPLICATE_SCAN_WINDOW_DAYS=7
EXPORT_RETENTION_DAYS=365
ESCALATION_EXPORTS_BUCKET=escalation-exports

# Local seed only: Auth user for the bootstrap HOH row
LOCAL_HOH_EMAIL=local-hoh@example.test
LOCAL_HOH_PASSWORD=
LOCAL_HOH_FULL_NAME=Local Bootstrap HOH

# apps/web (Next.js rewrites proxy /api to FastAPI)
# API_INTERNAL_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
