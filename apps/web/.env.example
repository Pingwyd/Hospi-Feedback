# FastAPI origin for Next.js rewrites (server-side only, not exposed to browser)
API_INTERNAL_URL=http://127.0.0.1:8000

# Public site URL for status links shown after wax-seal reveal
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebSocket origin for admin live inbox (browser connects directly to FastAPI)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
