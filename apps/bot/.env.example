# Copy to apps/bot/.env for local polling against staging or local API.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# FastAPI base URL (no trailing slash)
API_BASE_URL=http://127.0.0.1:8000

# Must match API TELEGRAM_IDENTIFIER_PEPPER for rate-limit hashes
TELEGRAM_IDENTIFIER_PEPPER=

# Required for admin /link and other bot-only API routes (same value as API)
BOT_SERVICE_SECRET=

# polling (local/staging) | webhook (production Render only, after cutover approval)
BOT_MODE=polling

# Required when BOT_MODE=webhook (public URL of the bot Render service, no trailing slash)
# WEBHOOK_BASE_URL=https://your-bot-service.onrender.com
